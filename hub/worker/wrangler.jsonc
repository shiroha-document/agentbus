{
  // agentbus hub Worker. Secrets (set with `wrangler secret put --env <env>`):
  //   TRIGGER_KEY, ACCESS_TEAM, ACCESS_AUD, ADMIN_EMAILS, E2E_SERVICE_TOKEN_ID (staging only)
  // Without ACCESS_TEAM / ACCESS_AUD every web request is rejected (fail closed).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentbus-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  "env": {
    "staging": {
      "name": "agentbus-hub-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging-hub.shiroha.tech", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agentbus-hub-staging",
          "database_id": "5e237cc1-569e-4e9c-a636-e22619eee267",
          "migrations_dir": "../migrations"
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [{ "name": "RL", "namespace_id": "1102", "simple": { "limit": 60, "period": 60 } }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "agentbus-files-staging" }],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "SIGNUP": "invite",
        "PUBLIC_URL": "https://staging-hub.shiroha.tech",
        "MAIL_FROM": "agentbus@shiroha.tech"
      }
    },
    "production": {
      "name": "agentbus-hub",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "hub.shiroha.tech", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agentbus-hub",
          "database_id": "74daa590-208c-41c0-935d-0d700c42a3b7",
          "migrations_dir": "../migrations"
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [{ "name": "RL", "namespace_id": "1101", "simple": { "limit": 60, "period": 60 } }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "agentbus-files" }],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "vars": {
        "ENVIRONMENT": "production",
        "SIGNUP": "invite",
        "PUBLIC_URL": "https://hub.shiroha.tech",
        "MAIL_FROM": "agentbus@shiroha.tech"
      }
    }
  }
}
