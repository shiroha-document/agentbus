diff --git a/deploy/runner/.env.example b/deploy/runner/.env.example
new file mode 100644
index 0000000..07db46e
--- /dev/null
+++ b/deploy/runner/.env.example
@@ -0,0 +1,16 @@
+# cp .env.example .env && chmod 600 .env   (.env is git-ignored; never commit it)
+
+# Where to register: an org name (all its repos can use the runner) or OWNER/REPO.
+RUNNER_SCOPE=your-org
+
+# Mode A (recommended): fine-grained PAT, resource owner = the org,
+# Organization permission "Self-hosted runners: Read and write".
+GITHUB_PAT=
+
+# Mode B: one-time token from Settings -> Actions -> Runners -> New runner (1h).
+RUNNER_TOKEN=
+
+# Workflows pick this runner when the variable AGENTBUS_RUNNER equals one of these labels.
+RUNNER_LABELS=agentbus
+# RUNNER_NAME=agentbus-mybox
+# RUNNER_GROUP=Default
diff --git a/deploy/runner/Dockerfile b/deploy/runner/Dockerfile
new file mode 100644
index 0000000..9cac7ed
--- /dev/null
+++ b/deploy/runner/Dockerfile
@@ -0,0 +1,24 @@
+# Self-hosted GitHub Actions runner for the agentbus workflows (ci / join /
+# digest). Based on GitHub's official runner image, plus the few tools our
+# jobs call directly: git (agentbus itself), gh (digest posting), jq, curl.
+FROM ghcr.io/actions/actions-runner:latest
+
+USER root
+RUN set -eux; \
+    apt-get update; \
+    apt-get install -y --no-install-recommends ca-certificates curl git jq openssh-client tar xz-utils; \
+    mkdir -p -m 755 /etc/apt/keyrings; \
+    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
+    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
+    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list; \
+    apt-get update; \
+    apt-get install -y --no-install-recommends gh; \
+    rm -rf /var/lib/apt/lists/*; \
+    mkdir -p /opt/hostedtoolcache; \
+    chown runner:runner /opt/hostedtoolcache
+
+COPY --chmod=755 entrypoint.sh /entrypoint.sh
+
+USER runner
+WORKDIR /home/runner
+ENTRYPOINT ["/entrypoint.sh"]
diff --git a/deploy/runner/compose.yml b/deploy/runner/compose.yml
new file mode 100644
index 0000000..c39a0cd
--- /dev/null
+++ b/deploy/runner/compose.yml
@@ -0,0 +1,23 @@
+# docker compose up -d --build          # one runner
+# docker compose up -d --scale runner=2 # two jobs in parallel
+services:
+  runner:
+    build: .
+    image: agentbus-runner:local
+    restart: unless-stopped
+    env_file: .env
+    environment:
+      RUNNER_TOOL_CACHE: /opt/hostedtoolcache   # setup-go downloads survive restarts
+      AGENT_TOOLSDIRECTORY: /opt/hostedtoolcache
+    volumes:
+      - toolcache:/opt/hostedtoolcache
+    # Deliberately NO /var/run/docker.sock mount: that would give every job root
+    # on this machine. Our workflows do not need Docker.
+    security_opt:
+      - no-new-privileges:true
+    cpus: 2
+    mem_limit: 4g
+    stop_grace_period: 30s
+
+volumes:
+  toolcache:
diff --git a/deploy/runner/entrypoint.sh b/deploy/runner/entrypoint.sh
new file mode 100644
index 0000000..594d96f
--- /dev/null
+++ b/deploy/runner/entrypoint.sh
@@ -0,0 +1,66 @@
+#!/usr/bin/env bash
+# Registers this container as a self-hosted runner and runs it.
+#
+# Two modes:
+#   GITHUB_PAT   (recommended) fine-grained PAT; a fresh registration token is
+#                fetched on every start and the runner is --ephemeral: one job,
+#                then the container exits and compose restarts it clean.
+#   RUNNER_TOKEN one-time registration token copied from the GitHub UI (valid
+#                1h). The runner is persistent; survives `restart`, but after
+#                `compose down` you need a new token.
+set -euo pipefail
+
+: "${RUNNER_SCOPE:?set RUNNER_SCOPE to an org (myorg) or a repo (owner/repo)}"
+API=${GITHUB_API:-https://api.github.com}
+LABELS=${RUNNER_LABELS:-agentbus}
+NAME=${RUNNER_NAME:-agentbus-$(hostname)}
+GROUP=${RUNNER_GROUP:-}
+URL=https://github.com/$RUNNER_SCOPE
+if [[ $RUNNER_SCOPE == */* ]]; then path=repos/$RUNNER_SCOPE; else path=orgs/$RUNNER_SCOPE; fi
+
+api_token() { # $1 = registration-token | remove-token
+	curl -fsS -X POST \
+		-H "Authorization: Bearer $GITHUB_PAT" \
+		-H "Accept: application/vnd.github+json" \
+		-H "X-GitHub-Api-Version: 2022-11-28" \
+		"$API/$path/actions/runners/$1" | jq -er .token
+}
+
+cd /home/runner
+extra=()
+if [[ -n ${GITHUB_PAT:-} ]]; then
+	rm -f .runner .credentials .credentials_rsaparams
+	if ! tok=$(api_token registration-token); then
+		echo "entrypoint: cannot get a registration token for $RUNNER_SCOPE." >&2
+		echo "  The PAT needs 'Self-hosted runners: Read and write' (org) or 'Administration: Read and write' (repo)." >&2
+		sleep 60 # avoid a hot restart loop
+		exit 1
+	fi
+	extra+=(--ephemeral)
+elif [[ -n ${RUNNER_TOKEN:-} ]]; then
+	tok=$RUNNER_TOKEN
+else
+	echo "entrypoint: set GITHUB_PAT or RUNNER_TOKEN in .env" >&2
+	exit 1
+fi
+[[ -n $GROUP ]] && extra+=(--runnergroup "$GROUP")
+
+if [[ ! -f .runner ]]; then
+	./config.sh --unattended --replace --disableupdate \
+		--url "$URL" --token "$tok" --name "$NAME" --labels "$LABELS" \
+		--work _work "${extra[@]}"
+fi
+unset tok RUNNER_TOKEN
+
+cleanup() {
+	# best effort: an ephemeral runner that never got a job would linger offline
+	if [[ -n ${GITHUB_PAT:-} && -f .runner ]]; then
+		rt=$(api_token remove-token) && ./config.sh remove --token "$rt" || true
+	fi
+}
+trap 'kill -TERM "$pid" 2>/dev/null; wait "$pid"; cleanup; exit 0' TERM INT
+
+# the PAT must not be visible to jobs
+env -u GITHUB_PAT ./run.sh &
+pid=$!
+wait "$pid"
-- 
